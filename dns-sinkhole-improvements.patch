@@ -0,0 +1,142 @@
+"""Unit tests for the DNS threat-scoring heuristics in scripts/dns_monitor.py."""
+import math
+
+import pytest
+
+import dns_monitor as dm
+
+
+# ── Shannon entropy ──────────────────────────────────────────────────────────
+def test_entropy_empty_string_is_zero():
+    assert dm.calculate_entropy("") == 0.0
+
+
+def test_entropy_single_repeated_char_is_zero():
+    assert dm.calculate_entropy("aaaaaaaa") == 0.0
+
+
+def test_entropy_two_equiprobable_symbols_is_one_bit():
+    assert dm.calculate_entropy("abab") == pytest.approx(1.0)
+
+
+def test_entropy_uniform_over_n_symbols_is_log2_n():
+    assert dm.calculate_entropy("abcdefgh") == pytest.approx(math.log2(8))
+
+
+def test_entropy_is_case_insensitive():
+    assert dm.calculate_entropy("AbAb") == dm.calculate_entropy("abab")
+
+
+# ── Levenshtein / typosquatting ──────────────────────────────────────────────
+@pytest.mark.parametrize(
+    "a,b,expected",
+    [("", "", 0), ("abc", "", 3), ("kitten", "sitting", 3), ("google", "gooogle", 1)],
+)
+def test_levenshtein_distance(a, b, expected):
+    assert dm.levenshtein_distance(a, b) == expected
+
+
+def test_levenshtein_is_symmetric():
+    assert dm.levenshtein_distance("paypal", "paypa1") == dm.levenshtein_distance("paypa1", "paypal")
+
+
+def test_exact_popular_domain_is_not_typosquat():
+    popular = next(iter(dm.POPULAR_DOMAINS))
+    assert dm.check_typosquatting(popular) is None
+
+
+def test_homoglyph_substitution_is_flagged():
+    popular = next(d for d in dm.POPULAR_DOMAINS if "l" in d or "i" in d)
+    swapped = popular.replace("l", "1", 1) if "l" in popular else popular.replace("i", "1", 1)
+    assert dm.check_typosquatting(swapped) == popular
+
+
+# ── Protocol detection ───────────────────────────────────────────────────────
+@pytest.mark.parametrize(
+    "transport,port,expected",
+    [
+        ("tcp", "853", "DoT"),
+        ("tcp", "443", "DoH"),
+        ("udp", "443", "DoQ"),
+        ("tcp", "53", "DNS/TCP"),
+        ("udp", "53", "DNS"),
+        ("udp", 53, "DNS"),
+    ],
+)
+def test_detect_protocol(transport, port, expected):
+    assert dm.detect_protocol(transport, port) == expected
+
+
+# ── Threat scoring ───────────────────────────────────────────────────────────
+def score(domain, rtype="A", rcode="NOERROR"):
+    return dm.score_threat(domain, rtype, rcode)
+
+
+def test_result_shape():
+    r = score("example.com")
+    assert set(r) == {"threatScore", "threatLevel", "threatReasons"}
+    assert r["threatLevel"] in {"low", "medium", "high"}
+
+
+def test_benign_domain_is_low():
+    assert score("www.wikipedia.org")["threatLevel"] == "low"
+
+
+def test_dga_style_domain_on_bad_tld_is_high():
+    r = score("xkqzjwvbtrpmnh8472913.tk")
+    assert r["threatLevel"] == "high"
+    assert any("TLD" in x for x in r["threatReasons"])
+
+
+def test_tunneling_style_long_deep_domain_is_flagged():
+    domain = "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4.e5f6a1b2c3d4e5f6a1b2c3d4.x.y.z.w.example.com"
+    r = score(domain, "TXT")
+    assert r["threatScore"] >= 30
+    assert any("subdomain depth" in x for x in r["threatReasons"])
+    assert any("TXT" in x for x in r["threatReasons"])
+
+
+def test_nxdomain_adds_points():
+    assert score("example.com", rcode="NXDOMAIN")["threatScore"] > score("example.com")["threatScore"]
+
+
+def test_score_is_never_negative_and_level_thresholds_hold():
+    for d in ["a.b", "x" * 70 + ".tk", "paypa1.com", "localhost", ""]:
+        r = score(d)
+        assert r["threatScore"] >= 0
+        expected = "high" if r["threatScore"] >= 60 else "medium" if r["threatScore"] >= 30 else "low"
+        assert r["threatLevel"] == expected
+
+
+# ── Regression tests for false positives / misses found during tuning ────────
+@pytest.mark.parametrize(
+    "domain",
+    [
+        "www.google.com", "github.com", "cdn.shopify.com", "docs.python.org",
+        "d1x7gh3k2.cloudfront.net", "s3.ap-south-1.amazonaws.com",
+        "mail.protonmail.ch", "login.microsoftonline.com", "api.github.com",
+    ],
+)
+def test_common_legit_domains_stay_low(domain):
+    assert score(domain)["threatLevel"] == "low"
+
+
+@pytest.mark.parametrize(
+    "domain",
+    ["xkqzjwvbtrpmnh8472913.tk", "zxcvbnmqwrtp.xyz", "a8f3k2m9x7q1z5w0.biz", "k3j9s8d7f6g5h4j2.com"],
+)
+def test_dga_style_domains_are_not_low(domain):
+    assert score(domain)["threatLevel"] in {"medium", "high"}
+
+
+def test_score_is_capped_at_100():
+    assert score("x" * 40 + "8472913." + "a.b.c.d.e.f.g." + "tk", "TXT", "NXDOMAIN")["threatScore"] <= 100
+
+
+def test_trusted_infra_helper():
+    assert dm.is_trusted_infra("d1.cloudfront.net")
+    assert not dm.is_trusted_infra("evilcloudfront.net")
+
+
+def test_name_entropy_ignores_short_names():
+    assert dm.name_entropy("a1.io") == 0.0
