+"""Smoke and input-validation tests for the Flask API."""
+import io
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import app as app_module  # noqa: E402
+
+
+@pytest.fixture()
+def client(tmp_path, monkeypatch):
+    monkeypatch.setattr(app_module, "UPLOAD_DIR", tmp_path)
+    flask_app = app_module.create_app()
+    flask_app.config["TESTING"] = True
+    return flask_app.test_client()
+
+
+def test_health(client):
+    r = client.get("/health")
+    assert r.status_code == 200
+    assert r.get_json()["status"] == "ok"
+
+
+def test_dns_data_shape(client):
+    r = client.get("/api/dns-data")
+    assert r.status_code == 200
+    assert isinstance(r.get_json(), dict)
+
+
+def test_upload_requires_file_part(client):
+    assert client.post("/api/upload-pcap").status_code == 400
+
+
+@pytest.mark.parametrize("name", ["evil.exe", "notes.txt", "shell.php", "capture.pcap.sh"])
+def test_upload_rejects_non_pcap_extensions(client, name):
+    r = client.post(
+        "/api/upload-pcap",
+        data={"pcap": (io.BytesIO(b"x"), name)},
+        content_type="multipart/form-data",
+    )
+    assert r.status_code == 400
+
+
+def test_upload_accepts_pcap_and_sanitises_name(client, tmp_path):
+    r = client.post(
+        "/api/upload-pcap",
+        data={"pcap": (io.BytesIO(b"\xd4\xc3\xb2\xa1"), "../../etc/evil.pcap")},
+        content_type="multipart/form-data",
+    )
+    assert r.status_code == 201
+    saved = Path(r.get_json()["pcapPath"])
+    assert saved.parent == tmp_path  # path traversal stripped by secure_filename
+    assert saved.exists()
