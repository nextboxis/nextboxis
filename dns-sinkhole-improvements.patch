+def is_trusted_infra(domain: str) -> bool:
+    """True when the domain sits under a well-known CDN / cloud suffix."""
+    d = domain.lower().rstrip(".")
+    return any(d == suf or d.endswith("." + suf) for suf in TRUSTED_INFRA_SUFFIXES)
+
+
+def name_entropy(domain: str) -> float:
+    """Shannon entropy of the domain *without* its TLD and label separators.
+
+    Scoring the full FQDN mixes in the TLD and dots, which inflates entropy for
+    ordinary names. Names shorter than 8 characters are ignored because very short
+    strings are statistically noisy.
+    """
+    labels = domain.lower().rstrip(".").split(".")
+    body = "".join(labels[:-1]) if len(labels) > 1 else labels[0]
+    return calculate_entropy(body) if len(body) >= 8 else 0.0
